# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# spike — desechable, fuera de SPABLA
/spike/

# supabase — CLI-managed local state (linked-project ref, pooler URL, versions)
supabase/.temp/
supabase/.branches/

# supabase — nested artifact created when 'supabase --workdir supabase start'
# is invoked from repo root. Must never be committed. See
# docs/standards/SPABLA_V2_TOOLCHAIN.md.
supabase/supabase/

# playwright — Hito 9.3.1-Q3-E2E · never commit E2E artifacts (may
# carry tokens, cookies, HAR, screenshots of authenticated UIs).
/playwright-report/
/test-results/
/blob-report/
/.playwright/
